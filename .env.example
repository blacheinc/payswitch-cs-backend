# =========================================
# PaySwitch Credit Scoring Platform - ENV
# =========================================

# Application
APP_NAME=PaySwitch Credit Scoring API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/v1
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Server
HOST=0.0.0.0
PORT=8000

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/credit_scoring
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0

# Azure Cosmos DB
COSMOS_ENDPOINT=https://localhost:8081
COSMOS_KEY=your-cosmos-key
COSMOS_DATABASE=credit_scoring

# Azure Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
AZURE_STORAGE_CONTAINER_BULK=bulk-uploads
AZURE_STORAGE_CONTAINER_TRAINING=training-data
AZURE_STORAGE_CONTAINER_REPORTS=reports

# Azure Key Vault
AZURE_KEYVAULT_URL=https://your-keyvault.vault.azure.net/

# Azure Service Bus
AZURE_SERVICEBUS_CONNECTION_STRING=
AZURE_SERVICEBUS_QUEUE_SCORING=scoring-jobs
AZURE_SERVICEBUS_QUEUE_WEBHOOKS=webhook-deliveries

# JWT
JWT_SECRET_KEY=CHANGE-ME-in-production-use-keyvault
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# API Key Settings
API_KEY_PREFIX_TEST=sk_test_
API_KEY_PREFIX_LIVE=sk_live_

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_DAY=50000
RATE_LIMIT_BURST=200

# Scoring
SCORING_TIMEOUT_SECONDS=5
SCORE_VALIDITY_DAYS=14

# Email (stub for now)
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@creditscoring.payswitch.com.gh
